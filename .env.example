# ==============================================================================
# RemoteRozgar Environment Variables Configuration
# ==============================================================================

# PostgreSQL database connection string (Neon or compatible Postgres instance with SSL)
DATABASE_URL="postgresql://neondb_owner:your_password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Admin single-account credentials (used solely for admin panel authentication)
ADMIN_EMAIL="admin@remoterozgar.com"
ADMIN_PASSWORD="replace_with_a_very_strong_password_minimum_16_chars"

# Secret key used for signing and verifying HMAC SHA-256 admin session cookies
ADMIN_SESSION_HMAC_SECRET="generate_a_random_64_char_hex_secret_here"

# Name of the HttpOnly session cookie storing the HMAC token
ADMIN_SESSION_COOKIE_NAME="rr_admin_session"

# Lifetime of the admin session in seconds (86400 = 24 hours)
ADMIN_SESSION_TTL_SECONDS="86400"

# Jobicy remote jobs public API endpoint
JOBICY_BASE_URL="https://jobicy.com/api/v2/remote-jobs"

# FX exchange rates provider endpoint for USD to PKR conversion
FX_PROVIDER_BASE_URL="https://open.er-api.com/v6/latest/USD"

# FX conversion cache lifetime in seconds (21600 = 6 hours)
FX_USD_TO_PKR_CACHE_TTL_SECONDS="21600"

# Canonical production website base URL without trailing slash or www
SITE_URL="https://remoterozgar.vercel.app"

# Public site display brand name
NEXT_PUBLIC_SITE_NAME="RemoteRozgar"

# Public default fiat currency displayed for South Asian remote workers
NEXT_PUBLIC_DEFAULT_CURRENCY="PKR"
