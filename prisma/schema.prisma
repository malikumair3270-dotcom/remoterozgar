datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Guide {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  category        String
  excerpt         String   @db.Text
  body            String   @db.Text
  coverImage      String
  publishedDate   DateTime @default(now())
  readTimeMinutes Int
  isFeatured      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([category])
  @@index([publishedDate(sort: Desc)])
}

model Job {
  id              String   @id @default(cuid())
  title           String
  companyName     String
  companyLogo     String?
  companyWebsite  String?
  category        String
  location        String
  jobType         String   @default("Full-Time")
  salaryMinUsd    Int?
  salaryMaxUsd    Int?
  salaryFormatted String?
  description     String   @db.Text
  applyUrl        String
  contactEmail    String?
  isFeatured      Boolean  @default(false)
  status          String   @default("PENDING") // PENDING, APPROVED, REJECTED, ARCHIVED
  source          String   @default("ADMIN")   // ADMIN, SUBMISSION
  adminNotes      String?  @db.Text
  pubDate         DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status, pubDate(sort: Desc)])
  @@index([category])
  @@index([source, status])
}

model JobSnapshot {
  id        String   @id @default(cuid())
  source    String   @default("jobicy")
  category  String   @default("all")
  data      String   @db.Text
  jobCount  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([source, category, createdAt(sort: Desc)])
}

model ExchangeRate {
  id             String   @id @default(cuid())
  baseCurrency   String   @default("USD")
  targetCurrency String   @default("PKR")
  rate           Float
  fetchedAt      DateTime @default(now())

  @@index([baseCurrency, targetCurrency, fetchedAt(sort: Desc)])
}

model RateLimitAttempt {
  id        String   @id @default(cuid())
  key       String
  timestamp DateTime @default(now())

  @@index([key, timestamp])
}
